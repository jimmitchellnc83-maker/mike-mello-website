---
// Navigation component for Mike Mello
const currentPath = Astro.url.pathname;
const navItems: Array<{ href: string; label: string }> = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/tour', label: 'Tour' },
  { href: '/videos', label: 'Videos' },
  { href: '/press', label: 'Press' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="bg-warm-dark/85 backdrop-blur-md text-warm-ivory border-b border-warm-ivory/10 sticky top-0 z-40">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between gap-4">
      <!-- Brand mark + wordmark -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 group">
        <span
          class="w-10 h-10 rounded-full bg-gradient-to-br from-spotlight-gold via-stage-amber to-spotlight-gold flex items-center justify-center text-stage-black font-bold text-sm tracking-tight shadow-md shadow-spotlight-gold/20 group-hover:shadow-spotlight-gold/40 transition-shadow font-display"
          aria-hidden="true"
        >
          MM
        </span>
        <span class="text-xl md:text-2xl font-bold tracking-tight group-hover:text-spotlight-gold transition-colors">
          Mike Mello
        </span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex space-x-6 lg:space-x-8 ml-auto">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'transition-colors text-sm lg:text-base',
                isActive(item.href) ? 'text-spotlight-gold' : 'hover:text-spotlight-gold',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Book Mike CTA (desktop) -->
      <a
        href="/contact"
        class="hidden md:inline-block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-2 px-5 rounded-md text-sm transition-colors flex-shrink-0 shadow-md shadow-spotlight-gold/20 hover:shadow-spotlight-gold/40"
      >
        Book Mike
      </a>

      <!-- Mobile Menu Button -->
      <button
        class="md:hidden text-warm-ivory p-2 -mr-2 rounded-md hover:bg-warm-ivory/5 transition-colors"
        data-mobile-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" data-icon-open fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="w-6 h-6 hidden" data-icon-close fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Panel -->
    <div id="mobile-menu" class="md:hidden hidden mt-4 pb-2 border-t border-warm-ivory/10 pt-3" data-mobile-menu>
      <a
        href="/contact"
        class="block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-3 px-4 rounded-md text-center mb-3 transition-colors"
      >
        Book Mike
      </a>
      <ul class="flex flex-col gap-1 text-lg">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'block py-3 px-3 rounded-md transition-colors',
                isActive(item.href)
                  ? 'text-spotlight-gold bg-spotlight-gold/10'
                  : 'text-warm-ivory hover:bg-warm-ivory/5 hover:text-spotlight-gold',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  function bindMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const menu = document.querySelector<HTMLDivElement>('[data-mobile-menu]');
    if (!toggle || !menu) return;
    if (toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';

    const openIcon = toggle.querySelector<SVGElement>('[data-icon-open]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-icon-close]');

    toggle.addEventListener('click', () => {
      const willOpen = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(willOpen));
      toggle.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
    });
  }

  bindMobileMenu();
  document.addEventListener('astro:page-load', bindMobileMenu);
</script>
