---
// Footer component for Mike Mello
---

<footer class="bg-warm-dark text-warm-ivory border-t border-warm-ivory/10 mt-auto">
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- About -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-spotlight-gold">Mike Mello</h3>
        <p class="text-aged-cream">
          Stand-up comedian. On stage, on tour, on tape.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-spotlight-gold">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-aged-cream hover:text-spotlight-gold transition-colors">About</a></li>
          <li><a href="/tour" class="text-aged-cream hover:text-spotlight-gold transition-colors">Tour Dates</a></li>
          <li><a href="/videos" class="text-aged-cream hover:text-spotlight-gold transition-colors">Videos</a></li>
          <li><a href="/press" class="text-aged-cream hover:text-spotlight-gold transition-colors">Press</a></li>
          <li><a href="/contact" class="text-aged-cream hover:text-spotlight-gold transition-colors">Booking</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-xl font-bold mb-4 text-spotlight-gold">Connect</h3>
        <ul class="space-y-2 text-aged-cream">
          <li>Booking & Press: <a href="/contact" class="text-spotlight-gold hover:text-stage-amber">Contact Mike</a></li>
        </ul>
        <div class="flex space-x-4 mt-4">
          <a href="https://www.instagram.com/mikemellomiller/" target="_blank" rel="noopener noreferrer" class="text-aged-cream hover:text-spotlight-gold transition-colors">Instagram</a>
          <a href="https://twitter.com/mikemellocomedy" target="_blank" rel="noopener noreferrer" class="text-aged-cream hover:text-spotlight-gold transition-colors">X</a>
          <a href="https://www.facebook.com/mello.m.miller/" target="_blank" rel="noopener noreferrer" class="text-aged-cream hover:text-spotlight-gold transition-colors">Facebook</a>
        </div>
      </div>
    </div>

    <div class="border-t border-warm-ivory/10 mt-8 pt-6 text-center text-smoke">
      <p>&copy; {new Date().getFullYear()} Mike Mello. All rights reserved.</p>
    </div>
  </div>
</footer>
