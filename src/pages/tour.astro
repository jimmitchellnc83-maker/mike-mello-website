---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tour Dates - Mike Mello" description="Upcoming tour dates and live shows for Mike Mello.">
	<div class="container mx-auto px-4 py-12">
		<h1 class="text-5xl font-bold text-center mb-12 text-slate-800">Tour Dates</h1>

		<div class="max-w-4xl mx-auto">
			<!-- Show 1 -->
			<article class="bg-white p-8 rounded-lg shadow-lg mb-6">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between">
					<div class="mb-4 md:mb-0">
						<p class="text-sm text-gray-500 uppercase tracking-wide">[Date]</p>
						<h2 class="text-2xl font-bold text-amber-600">[Venue Name]</h2>
						<p class="text-gray-700">[City, State]</p>
					</div>
					<a href="#" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-6 rounded-lg transition-colors text-center">
						Tickets
					</a>
				</div>
			</article>

			<!-- Show 2 -->
			<article class="bg-white p-8 rounded-lg shadow-lg mb-6">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between">
					<div class="mb-4 md:mb-0">
						<p class="text-sm text-gray-500 uppercase tracking-wide">[Date]</p>
						<h2 class="text-2xl font-bold text-amber-600">[Venue Name]</h2>
						<p class="text-gray-700">[City, State]</p>
					</div>
					<a href="#" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-6 rounded-lg transition-colors text-center">
						Tickets
					</a>
				</div>
			</article>

			<!-- Show 3 -->
			<article class="bg-white p-8 rounded-lg shadow-lg mb-6">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between">
					<div class="mb-4 md:mb-0">
						<p class="text-sm text-gray-500 uppercase tracking-wide">[Date]</p>
						<h2 class="text-2xl font-bold text-amber-600">[Venue Name]</h2>
						<p class="text-gray-700">[City, State]</p>
					</div>
					<a href="#" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-6 rounded-lg transition-colors text-center">
						Tickets
					</a>
				</div>
			</article>

			<!-- Mailing list / alerts -->
			<section class="mt-12">
				<h2 class="text-3xl font-bold mb-6 text-slate-800">Get Show Alerts</h2>
				<div class="bg-slate-100 p-8 rounded-lg">
					<p class="text-lg text-gray-700 mb-4">
						Want to know when Mike is in your city? Drop your email and get tour alerts.
					</p>
					<p class="text-sm text-gray-500">
						[Mailing-list signup form to be added]
					</p>
				</div>
			</section>
		</div>
	</div>
</Layout>
