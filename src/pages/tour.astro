---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mike Mello Tour Dates & Live Shows | Book Mike for Your Stage" description="Mike Mello tour dates and live shows. Book Mike for stand-up at comedy clubs, colleges, corporate events, private parties, and festivals nationwide.">
	<div class="container mx-auto px-4 py-12">
		<h1 class="text-5xl font-bold text-center mb-12 text-warm-ivory">Tour Dates</h1>

		<div class="max-w-5xl mx-auto">
			<!-- Status / empty state with promo image -->
			<div class="bg-dim-house border border-warm-ivory/10 rounded-lg overflow-hidden">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-0">
					<div class="p-10 flex flex-col justify-center text-center md:text-left">
						<p class="text-xs uppercase tracking-widest text-smoke mb-4">Tour Status</p>
						<h2 class="text-3xl font-bold text-spotlight-gold mb-4">New Dates Being Booked</h2>
						<p class="text-aged-cream mb-8">
							Mike's working out the next run. Follow on Instagram for show announcements as they're posted, or get in touch about a private booking, college, club, or corporate date.
						</p>
						<div class="flex flex-col sm:flex-row gap-4 md:justify-start justify-center">
							<a
								href="https://www.instagram.com/mikemellomiller/"
								target="_blank"
								rel="noopener noreferrer"
								class="inline-block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-3 px-8 rounded-lg transition-colors text-center"
							>
								Follow on Instagram
							</a>
							<a
								href="/contact"
								class="inline-block bg-transparent border border-warm-ivory/20 text-warm-ivory hover:bg-warm-ivory/10 font-bold py-3 px-8 rounded-lg transition-colors text-center"
							>
								Booking Inquiry
							</a>
						</div>
					</div>
					<div class="hidden md:block relative bg-amber-shadow min-h-72">
						<img
							src="/images/neptunes-comedy-promo.jpg"
							alt="Mike Mello holding the mic at Neptunes Comedy, The Pour House in Raleigh — show promo"
							class="absolute inset-0 w-full h-full object-cover opacity-70"
							loading="lazy"
						/>
						<div class="absolute inset-0 bg-gradient-to-l from-transparent via-stage-black/30 to-stage-black/60"></div>
					</div>
				</div>
			</div>

		</div>
	</div>
</Layout>
