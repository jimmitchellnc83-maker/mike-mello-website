---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mike Mello - Stand-Up Comedian">
	<!-- Hero Section -->
	<section class="relative bg-stage-black overflow-hidden min-h-[75vh] md:min-h-[85vh] flex items-end">
		<div class="absolute inset-0" aria-hidden="true">
			<img
				src="/images/raleigh-improv-stage.jpg"
				alt=""
				class="w-full h-full object-cover object-[center_25%] opacity-90"
				loading="eager"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-stage-black/10 via-stage-black/30 to-stage-black"></div>
		</div>
		<div class="relative container mx-auto px-4 text-center pb-12 md:pb-20">
			<h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-4 text-warm-ivory [text-shadow:0_2px_16px_rgba(0,0,0,0.7)]">
				Mike Mello
			</h1>
			<p class="text-xl md:text-2xl text-aged-cream mb-3 [text-shadow:0_1px_8px_rgba(0,0,0,0.8)]">
				Stand-Up Comedian
			</p>
			<p class="text-base md:text-lg text-warm-ivory/90 mb-10 max-w-2xl mx-auto [text-shadow:0_1px_6px_rgba(0,0,0,0.8)]">
				20+ years on the road. Shared stages with Tracy Morgan, Russell Peters, and Dave Chappelle.
			</p>
			<a href="/tour" class="inline-block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-3 px-8 rounded-lg transition-colors shadow-xl">
				See Tour Dates
			</a>
		</div>
	</section>

	<!-- Featured Section -->
	<section class="py-16">
		<div class="container mx-auto px-4">
			<h2 class="text-4xl font-bold text-center mb-12 text-warm-ivory">
				What's Going On
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Live Shows -->
				<div class="bg-dim-house border border-warm-ivory/10 p-8 rounded-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-spotlight-gold">Live Shows</h3>
					<p class="text-aged-cream">
						Catch Mike on the road — clubs, theaters, and festivals across the country.
					</p>
				</div>

				<!-- Videos -->
				<div class="bg-dim-house border border-warm-ivory/10 p-8 rounded-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-spotlight-gold">Watch</h3>
					<p class="text-aged-cream">
						Mike's hour-long special <em>Incognegro</em>, his set on <em>D.L. Hughley's Speakeasy</em>, and club clips.
					</p>
				</div>

				<!-- Booking -->
				<div class="bg-dim-house border border-warm-ivory/10 p-8 rounded-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-spotlight-gold">Booking</h3>
					<p class="text-aged-cream">
						For private events, corporate, college, and club bookings — get in touch.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- On the Road -->
	<section class="bg-warm-dark py-16">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-4xl font-bold mb-4 text-warm-ivory">On the Road</h2>
			<p class="text-lg text-aged-cream mb-8 max-w-2xl mx-auto">
				From Charlie Goodnight's to Segra Stadium — and everywhere in between. Follow along for the next set of dates.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/tour" class="inline-block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-3 px-8 rounded-lg transition-colors">
					Tour Dates
				</a>
				<a href="https://www.instagram.com/mikemellomiller/" target="_blank" rel="noopener noreferrer" class="inline-block bg-transparent border border-warm-ivory/20 text-warm-ivory hover:bg-warm-ivory/10 font-bold py-3 px-8 rounded-lg transition-colors">
					Follow @mikemellomiller
				</a>
			</div>
		</div>
	</section>
</Layout>
