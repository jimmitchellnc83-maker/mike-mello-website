---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mike Mello - Stand-Up Comedian">
	<!-- Hero Section -->
	<section class="bg-slate-800 text-white py-20">
		<div class="container mx-auto px-4 text-center">
			<h1 class="text-5xl md:text-6xl font-bold mb-4">
				Mike Mello
			</h1>
			<p class="text-xl md:text-2xl text-gray-300 mb-8">
				Stand-Up Comedian
			</p>
			<a href="/tour" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-8 rounded-lg transition-colors">
				See Tour Dates
			</a>
		</div>
	</section>

	<!-- Featured Section -->
	<section class="py-16">
		<div class="container mx-auto px-4">
			<h2 class="text-4xl font-bold text-center mb-12 text-slate-800">
				What's Going On
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Live Shows -->
				<div class="bg-white p-8 rounded-lg shadow-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-amber-600">Live Shows</h3>
					<p class="text-gray-600">
						Catch Mike on the road — clubs, theaters, and festivals across the country.
					</p>
				</div>

				<!-- Videos -->
				<div class="bg-white p-8 rounded-lg shadow-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-amber-600">Watch</h3>
					<p class="text-gray-600">
						Stand-up clips, specials, and viral moments. [Featured videos to be added]
					</p>
				</div>

				<!-- Booking -->
				<div class="bg-white p-8 rounded-lg shadow-lg text-center">
					<h3 class="text-2xl font-bold mb-4 text-amber-600">Booking</h3>
					<p class="text-gray-600">
						For private events, corporate, college, and club bookings — get in touch.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Next Show Snapshot -->
	<section class="bg-slate-100 py-16">
		<div class="container mx-auto px-4 text-center">
			<h2 class="text-4xl font-bold mb-8 text-slate-800">Next Show</h2>
			<p class="text-xl text-gray-700 mb-4">
				[Venue, City]
			</p>
			<p class="text-lg text-gray-600 mb-8">
				[Date & Time to be added]
			</p>
			<a href="/tour" class="inline-block bg-slate-800 hover:bg-slate-700 text-white font-bold py-3 px-8 rounded-lg transition-colors">
				All Tour Dates
			</a>
		</div>
	</section>
</Layout>
