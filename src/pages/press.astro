---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Press - Mike Mello" description="Press kit, photos, bio, and media coverage for Mike Mello.">
	<div class="container mx-auto px-4 py-12">
		<h1 class="text-5xl font-bold text-center mb-12 text-slate-800">Press</h1>

		<div class="max-w-4xl mx-auto">
			<!-- Press Kit -->
			<section class="mb-12">
				<div class="bg-white p-8 rounded-lg shadow-lg">
					<h2 class="text-3xl font-bold mb-6 text-amber-600">Press Kit</h2>
					<p class="text-gray-700 mb-4">
						Hi-res photos, official bio, logos, and tech rider — everything you need.
					</p>
					<a href="#" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-8 rounded-lg transition-colors">
						Download Press Kit
					</a>
					<p class="text-sm text-gray-500 mt-3">
						[Press kit zip / link to be added]
					</p>
				</div>
			</section>

			<!-- Coverage -->
			<section class="mb-12">
				<h2 class="text-3xl font-bold mb-6 text-amber-600">Coverage</h2>

				<article class="bg-white p-8 rounded-lg shadow-lg mb-6">
					<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
						<h3 class="text-2xl font-bold text-slate-800 mb-2 md:mb-0">[Article / Review Title]</h3>
						<span class="text-gray-600 font-semibold">[Outlet · Date]</span>
					</div>
					<p class="text-gray-700 mb-4">
						"[Pull quote from the piece.]"
					</p>
					<a href="#" class="text-amber-600 hover:text-amber-700 font-semibold">Read more →</a>
				</article>

				<article class="bg-white p-8 rounded-lg shadow-lg mb-6">
					<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
						<h3 class="text-2xl font-bold text-slate-800 mb-2 md:mb-0">[Article / Review Title]</h3>
						<span class="text-gray-600 font-semibold">[Outlet · Date]</span>
					</div>
					<p class="text-gray-700 mb-4">
						"[Pull quote from the piece.]"
					</p>
					<a href="#" class="text-amber-600 hover:text-amber-700 font-semibold">Read more →</a>
				</article>
			</section>

			<!-- Press Photos -->
			<section>
				<h2 class="text-3xl font-bold mb-6 text-amber-600">Press Photos</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="bg-slate-200 rounded-lg shadow-lg h-64 flex items-center justify-center">
						<p class="text-gray-600">[Press Photo 1]</p>
					</div>
					<div class="bg-slate-200 rounded-lg shadow-lg h-64 flex items-center justify-center">
						<p class="text-gray-600">[Press Photo 2]</p>
					</div>
					<div class="bg-slate-200 rounded-lg shadow-lg h-64 flex items-center justify-center">
						<p class="text-gray-600">[Press Photo 3]</p>
					</div>
				</div>
			</section>
		</div>
	</div>
</Layout>
