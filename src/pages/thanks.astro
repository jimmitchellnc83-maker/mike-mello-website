---
import Layout from '../layouts/Layout.astro';

const title = "Thanks | Mike Mello";
const description = "Mike got your message and will reply within 48 hours.";
---

<Layout title={title} description={description} noindex={true}>
	<section class="container mx-auto px-4 py-24 text-center max-w-2xl">
		<p class="text-xs uppercase tracking-widest text-smoke mb-3">Inquiry received</p>
		<h1 class="text-4xl md:text-5xl font-bold text-warm-ivory mb-4">Thanks. Mike's got it.</h1>
		<p class="text-lg text-aged-cream mb-10">
			You'll hear back within 48 hours. If your timeline is tight, DM <a href="https://www.instagram.com/mikemellomiller/" target="_blank" rel="noopener noreferrer" class="text-spotlight-gold hover:text-stage-amber">@mikemellomiller</a> on Instagram.
		</p>
		<div class="flex flex-col sm:flex-row gap-3 justify-center">
			<a href="/" class="inline-block bg-spotlight-gold hover:bg-stage-amber text-stage-black font-bold py-3 px-6 rounded-lg transition-colors">Back home</a>
			<a href="/videos" class="inline-block bg-transparent border border-warm-ivory/20 text-warm-ivory hover:bg-warm-ivory/10 font-bold py-3 px-6 rounded-lg transition-colors">Watch a clip</a>
		</div>
	</section>
</Layout>
