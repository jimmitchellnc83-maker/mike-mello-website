---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Mike Mello" description="About Mike Mello — stand-up comedian, credits, and bio.">
	<div class="container mx-auto px-4 py-12">
		<h1 class="text-5xl font-bold text-center mb-12 text-slate-800">About</h1>

		<!-- Bio -->
		<section class="mb-16 max-w-4xl mx-auto">
			<h2 class="text-3xl font-bold mb-6 text-amber-600">Bio</h2>
			<div class="bg-white p-8 rounded-lg shadow-lg">
				<p class="text-gray-700 mb-4">
					[Short bio to be added — origin story, comedic voice, what makes Mike's act distinct.]
				</p>
				<p class="text-gray-700">
					[Long-form bio paragraph — career arc, influences, current projects.]
				</p>
			</div>
		</section>

		<!-- Credits -->
		<section class="mb-16 max-w-4xl mx-auto">
			<h2 class="text-3xl font-bold mb-6 text-amber-600">Credits</h2>
			<div class="bg-white p-8 rounded-lg shadow-lg">
				<ul class="space-y-3 text-lg text-gray-700">
					<li>[TV / streaming appearance]</li>
					<li>[Festival appearance]</li>
					<li>[Podcast appearance]</li>
					<li>[Album / special]</li>
				</ul>
			</div>
		</section>

		<!-- Quotes / Press blurb -->
		<section class="max-w-4xl mx-auto">
			<h2 class="text-3xl font-bold mb-6 text-amber-600">What People Are Saying</h2>
			<div class="bg-slate-100 p-8 rounded-lg">
				<blockquote class="text-xl italic text-gray-700 mb-2">
					"[Pull quote from a review or peer]"
				</blockquote>
				<p class="text-sm text-gray-500">— [Source]</p>
			</div>
		</section>
	</div>
</Layout>
