---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  schema?: object | object[];
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ProfilePage';
}

const {
  title = 'Mike Mello | Stand-Up Comedian | Booking Clubs, Colleges, Corporate, & Private Events',
  description = 'Mike Mello is a Raleigh, NC stand-up comedian with 20+ years on the road. NBC Stand-Up Diversity finalist. Two specials. Book Mike for clubs, colleges, corporate, private events, and hosting.',
  schema,
  pageType = 'WebPage'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/raleigh-improv-stage.jpg', Astro.site).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://mikemello.com/#person',
  name: 'Mike Mello',
  alternateName: ['Mello Mike', 'Mike Mello Miller', 'Michael Miller'],
  jobTitle: 'Stand-Up Comedian',
  description:
    "Stand-up comedian with 20+ years on the road, based in Raleigh, NC. NBC Stand-Up Diversity Showcase finalist. Toured with Tracy Morgan and Russell Peters; opened for Dave Chappelle, Ralphie May, D.L. Hughley, and Damon Wayans. Two specials: Incognegro (2018) and What's Seasoning? on HITKOR.",
  url: 'https://mikemello.com',
  image: ogImage,
  knowsAbout: ['Stand-up comedy', 'Comedy writing', 'Hosting', 'Emcee work'],
  homeLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Raleigh',
      addressRegion: 'NC',
      addressCountry: 'US'
    }
  },
  birthPlace: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'VA',
      addressCountry: 'US'
    }
  },
  sameAs: [
    'https://www.imdb.com/name/nm9610033/',
    'https://www.instagram.com/mikemellomiller/',
    'https://twitter.com/mikemellocomedy',
    'https://www.facebook.com/mello.m.miller/'
  ],
  award: 'NBC Stand-Up Diversity Showcase finalist'
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://mikemello.com/#website',
  url: 'https://mikemello.com',
  name: 'Mike Mello',
  description: 'Official website of stand-up comedian Mike Mello',
  publisher: { '@id': 'https://mikemello.com/#person' },
  inLanguage: 'en-US'
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://mikemello.com/#booking',
  name: 'Mike Mello Stand-Up Comedy Booking',
  description:
    'Book stand-up comedian Mike Mello for comedy clubs, colleges, corporate events, private parties, festivals, and hosting/emcee work.',
  provider: { '@id': 'https://mikemello.com/#person' },
  serviceType: [
    'Stand-up comedy performance',
    'Comedy club headliner',
    'College and university comedy',
    'Corporate entertainment',
    'Private event entertainment',
    'Festival comedy',
    'Hosting and emcee'
  ],
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: {
    '@type': 'PeopleAudience',
    audienceType:
      'Comedy club bookers, college activity boards, corporate event planners, private event hosts, festival programmers'
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: 'https://mikemello.com/contact',
    name: 'Send a booking inquiry'
  }
};

// Per-page WebPage schema with proper subtype
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': canonicalURL.toString() + '#webpage',
  url: canonicalURL.toString(),
  name: title,
  description: description,
  isPartOf: { '@id': 'https://mikemello.com/#website' },
  about: { '@id': 'https://mikemello.com/#person' },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  inLanguage: 'en-US'
};

// Auto-generate BreadcrumbList from URL pathname (only on subpages)
const segments = Astro.url.pathname.split('/').filter(Boolean);
let breadcrumbSchema: object | null = null;
if (segments.length > 0) {
  const items: object[] = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://mikemello.com/' }
  ];
  let path = '';
  segments.forEach((seg, i) => {
    path += '/' + seg;
    const name = seg
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
    items.push({
      '@type': 'ListItem',
      position: i + 2,
      name,
      item: `https://mikemello.com${path}/`
    });
  });
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items
  };
}

const allSchema: object[] = [personSchema, websiteSchema, serviceSchema, webPageSchema];
if (breadcrumbSchema) allSchema.push(breadcrumbSchema);
if (schema) {
  if (Array.isArray(schema)) allSchema.push(...schema);
  else allSchema.push(schema);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/favicon.svg" />
		<link rel="mask-icon" href="/favicon.svg" color="#C98B2A" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0F0C09" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Mike Mello" />
		<title>{title}</title>

		<!-- Fonts: Fraunces (display) + Switzer (body) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,0..100&display=swap" rel="stylesheet" />
		<link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600,700&display=swap" rel="stylesheet" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Mike Mello" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="Mike Mello performing on stage at Raleigh Improv" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:creator" content="@MikeMelloComedy" />
		<meta name="twitter:site" content="@MikeMelloComedy" />

		<!-- Structured data -->
		{allSchema.map((s) => (
			<script type="application/ld+json" set:html={JSON.stringify(s)} />
		))}

		<!-- Smooth view transitions between pages -->
		<ClientRouter />
	</head>
	<body class="flex flex-col min-h-screen bg-stage-black text-warm-ivory">
		<Header />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
